# Port d'écoute de l'API
PORT=3000

# Base SQLite (chemin relatif à la racine du projet)
DATABASE_URL=file:./dev.db

# Secret de signature des JWT : 16 caractères minimum, obligatoire (l'API refuse de démarrer sans)
JWT_SECRET=change-me-with-a-long-random-string

# Durée de vie des jetons (facultatif, "2h" par défaut)
JWT_EXPIRES_IN=2h

# Niveau des logs : fatal, error, warn, info, debug, trace ou silent (facultatif, "info" par défaut)
LOG_LEVEL=info

# Prestataire de paiement : "http" (le simulateur ou un vrai prestataire) ou "fake" (réponses factices)
PAYMENT_PROVIDER=http
PAYMENT_URL=http://localhost:4010
# Clé secrète du prestataire, obligatoire avec PAYMENT_PROVIDER=http (simulateur du kit : sk_test_roulotte)
PAYMENT_API_KEY=sk_test_roulotte

# Origine autorisée par CORS : l'adresse du front
CORS_ORIGIN=http://localhost:5173

# Dossier où sont enregistrées les photos des plats, servies sous /uploads (facultatif, "uploads" par défaut)
UPLOAD_DIR=uploads

# Durée du cache de la carte en millisecondes ; 0 désactive le cache (facultatif, 30000 par défaut)
MENU_CACHE_TTL_MS=30000
