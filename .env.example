# Port d'écoute de l'API
PORT=3000

# Base SQLite (chemin relatif à la racine du projet)
DATABASE_URL=file:./dev.db

# Secret de signature des JWT : 16 caractères minimum, obligatoire (l'API refuse de démarrer sans)
JWT_SECRET=change-me-with-a-long-random-string

# Durée de vie des jetons (facultatif, "2h" par défaut)
JWT_EXPIRES_IN=2h

# Niveau des logs : fatal, error, warn, info, debug, trace ou silent (facultatif, "info" par défaut)
LOG_LEVEL=info

# Origine autorisée par CORS : l'adresse du front
CORS_ORIGIN=http://localhost:5173
